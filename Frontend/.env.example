# Server-only Upstash credentials used by the shared Crowd Pick panel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server-only keys used by the Run model and the future authoritative runner.
OPENROUTER_API_KEY=
RUNNER_SECRET_KEY=
# Temporary public, local-only Hunt play mode. Set true only while previewing.
NEXT_PUBLIC_JEV_HUNT_PLAY_MODE=false
# Temporary public, local-only Forest play mode. Set true only while previewing.
NEXT_PUBLIC_JEV_FOREST_PLAY_MODE=false
# Public Firebase client configuration. Copy the database URL from Firebase Console.
NEXT_PUBLIC_FIREBASE_PUBLIC_API_KEY=
NEXT_PUBLIC_FIREBASE_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PUBLIC_APP_ID=
NEXT_PUBLIC_FIREBASE_PUBLIC_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_PUBLIC_DATABASE_URL=
# Firebase Admin credentials: server-only, never NEXT_PUBLIC_.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
